[Unit]
Description=Catequesis de adultos
After=network.target

[Service]
Type=simple
User=catequesis
Group=catequesis
WorkingDirectory=/opt/catequesis
EnvironmentFile=/etc/catequesis.env
ExecStart=/usr/bin/node /opt/catequesis/backend/app.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=40
UMask=0077
StateDirectory=catequesis
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/catequesis

[Install]
WantedBy=multi-user.target

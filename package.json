{
  "name": "catequesis-adultos",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "local": "node backend/app.js --demo",
    "test:local": "node --test --test-concurrency=1 backend/tests/*.test.js",
    "check": "npm run build",
    "dev": "vite --config frontend/vite.config.js",
    "build": "vite build --config frontend/vite.config.js",
    "start": "node backend/app.js --demo",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:all": "npm run test && npm run test:local",
    "lint": "eslint frontend backend tests"
  },
  "dependencies": {
    "lucide-react": "^1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "9.39.4",
    "tailwindcss": "4.2.1",
    "vite": "8.0.13"
  },
  "type": "module",
  "displayName": "Catequesis de adultos"
}
